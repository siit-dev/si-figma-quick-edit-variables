{
  "name": "si-quick-edit-variables",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "author": "Smart Impact",
  "repository": {
    "type": "git",
    "url": "https://github.com/siit-dev/si-figma-quick-edit-variables.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.ui.config.ts",
    "build": "npm run clean && npm run build:main && npm run build:ui",
    "package:plugin": "node scripts/package-plugin.mjs",
    "release:check": "node scripts/verify-release.mjs",
    "build:main": "vite build --config vite.main.config.ts && node scripts/verify-sandbox.mjs",
    "build:ui": "vite build --config vite.ui.config.ts && node scripts/finalize-ui.mjs",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite-plugin-singlefile": "latest"
  },
  "devDependencies": {
    "@figma/plugin-typings": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "fflate": "^0.8.3",
    "jsdom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
